      "name": "Prepare CRM Status"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst crmStatus = String(data.crm_status ?? \"\").trim().toLowerCase();\nconst carrierStatus = String(data.carrier_status ?? \"\").trim().toLowerCase();\nconst requestType = String(data.request_type ?? \"\").trim().toLowerCase();\n\nconst isDeliveryNotReceived = requestType === \"delivery_not_received\";\n\nconst routingDecision =\n  isDeliveryNotReceived\n    ? \"human_handoff\"\n    : crmStatus === \"delivered\" && carrierStatus === \"delivered\"\n      ? \"automatic\"\n      : \"human_handoff\";\n\nreturn [\n  {\n    json: {\n      ...data,\n      routing_decision: routingDecision,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
